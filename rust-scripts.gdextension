[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://rust-scripts/target/debug/librust_scripts.so"
linux.release.x86_64 =   "res://rust-scripts/target/release/librust_scripts.so"
windows.debug.x86_64 =   "res://rust-scripts/target/x86_64-pc-windows-gnu/debug/rust_scripts.dll"
windows.release.x86_64 = "res://rust-scripts/target/x86_64-pc-windows-gnu/release/rust_scripts.dll"
macos.debug =            "res://rust-scripts/target/debug/librust_scripts.dylib"
macos.release =          "res://rust-scripts/target/release/librust_scripts.dylib"
macos.debug.arm64 =      "res://rust-scripts/target/debug/librust_scripts.dylib"
macos.release.arm64 =    "res://rust-scripts/target/release/librust_scripts.dylib"
web.debug.wasm32 =       "res://rust-scripts/target/wasm32-unknown-emscripten/debug/rust_scripts.wasm"
web.release.wasm32 =     "res://rust-scripts/target/wasm32-unknown-emscripten/release/rust_scripts.wasm"
