==column:wall==
V:
 F
  @
--> column_caps * u_top
V:
  =
 . .
  @
--> column_middle * u_top
--> column_floating * u_top

==column:wall==  # multiple stanzas produces multiple independent rules
V:
  @
 F
--> column_caps * u_bottom
V:
  @
 . .
  =
--> column_middle * u_bottom
--> column_floating * u_bottom

==railing:wall==
H: 1=stairs:90
 @1
--> stair_railing
H:
  .
 . .
  @
 . .
  .
--> railing_cap * railing_cap:180
H:
  .
 . .
  @
--> railing_cap
--> railing     # by default, models meet at integer coordinates

==wall:wall==
V:
 O .
  @
--> wall * u_shorten_under_roof # get out of the way of the roofline; the eave will cover it up.
--> wall
==window:wall==
V:
 O .
  @
--> window * u_shorten_under_roof # get out of the way of the roofline; the eave will cover it up.
--> window
==doorway:wall==
V:
 O .
  @
--> doorway * u_shorten_under_roof # get out of the way of the roofline; the eave will cover it up.
--> doorway

==wall:wall==
|H narrow|H|:
 | .   |  .  |
 |     | w . |
 | O . |  @  |
--> (multi) v_corner_fill_full * u_shorten_under_roof
H:
   .
  w .
   @
--> (multi) v_corner_fill_full # We should probably flip rules, and not use the `_full` version

==window:wall==
H:
  .
 w .
  @ 
--> (multi) v_corner_fill_full

==doorway:wall==
H:
  .
 w .
  @ 
--> (multi) v_corner_fill_full

==floor:floor==
--> floor

==floor:floor==
V:  
  .
 w .
  @ 
--> h_corner_fill_full:90

==floor:floor==
V:
  .
 @ .
  w
--> (multi) h_corner_fill_full_ceiling:90

==roof:floor==
V:
    .
 = @ .
    w
--> (multi) eave

==roof:floor==
|H narrow|H|:
 | .   |  .  |
 |     | w . |
 | @ . |  w  |
--> (multi) eave_corner:90

==roof:floor==
V:
 =
 .
 @
--> cube_roof
V:
 =
  
 = @
--> slant_roof          # Give gables nice flat sides
H narrow:
 .. ..
 . r .
  r@..
 . r .
 .. ..
--> slant_roof * slant_roof:90 * slant_roof:270 , slant_roof * slant_roof:180 # highly-specific; kind of a hack?
H narrow:
    ..
   r .
  r@r
   r .
    ..
--> slant_roof , slant_roof:90 * slant_roof:270  # double valley
H narrow:
    ..
   r .
  r@r
   r
--> slant_roof , slant_roof:90  # valley
H narrow:
   r
  r@r
   r
--> cube_roof
H narrow:
   r
  r@
   r
--> slant_roof
|H narrow|H narrow|:
  |   .  |      |
  |   .  |      |
  |r r@..|    ..|
  |   r  |      |
  |    ..|    ..|
  |   .  |      |
  |   .  |      |
  
--> slant_roof:90                    # Don't have a big jerkinhed
|H narrow|H narrow|:
  |   .  |      |
  |   .  |      |
  |    ..|    ..|
  |   r  |      |
  |r r@..|    ..|
  |   .  |      |
  |   .  |      |
--> slant_roof:270                   # Don't have a big jerkinhed
H narrow:
  r@
   r
--> slant_roof * slant_roof:90
H narrow:
 r@r
--> slant_roof:90 * slant_roof:270
|H narrow|H narrow|:
  |r@..|  ..|
--> slant_roof:90 * slant_roof:270   # Don't have a jerkinhed
H narrow:
 r@
--> slant_roof * slant_roof:90 * slant_roof:270
H narrow:
   .
   .
 ..@..
   .
   .
--> slant_roof * slant_roof:90 * slant_roof:180 * slant_roof:270
--> cube_roof

# Currently, don't use rules for 'stairs' so that they maintain their original direction.
