==column:wall==
V wide:
 F
  @
--> column_caps * top
V wide:
  =
 . .
  @
--> column_middle * top
--> column_floating * top

==column:wall==  # multiple stanzas produces multiple independent rules
V wide:
  @
 F
--> column_caps * bottom
V wide:
  @
 . .
  =
--> column_middle * bottom
--> column_floating * bottom

==railing:wall==
H:
 @S
--> none    # handled by staircase, since staircase knows its orientation
H:
  .
  
  @
  
  .
--> railing_cap * railing_cap:180
H:
 .

 @
--> railing_cap
V wide:
  @
 F .
--> reinforced_railing   # just for demonstration purposes
--> railing     # by default, models meet at integer coordinates now

==roof:room==
V wide:
 =
 .
 @
--> solid_roof
H:
   =
   .
 =.@
   .
   =
--> slant_roof
H:
 =.@
   .
   =
--> slant_roof * slant_roof:90
H:
 =.@
--> slant_roof * slant_roof:90 * slant_roof:270
H:
 .@W
--> (multi) slant_roof   # TODO: walls somehow?
H:
   .
   .
 ..@..
   .
   .
--> slant_roof * slant_roof:90 * slant_roof:180 * slant_roof:270
--> solid_roof

==stairs:room==
H:
 @R
--> stair_railing
==stairs:room==
--> stairs
